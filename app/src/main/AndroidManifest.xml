<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talking to the Anthropic and Gmail APIs. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: alerts for new trips, balance changes and expiring points found by the background email sync (Android 13+ asks at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android 11+ (API 30+) hides other installed apps from package queries
      by default ("package visibility"). Without declaring this, AppAuth
      can't detect a browser or Chrome Custom Tabs is installed to open the
      Google sign-in page, and crashes instead of failing gracefully when
      "Connect Gmail" is tapped.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".TravelBenefitsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.TravelBenefits"
        android:supportsRtl="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TravelBenefits"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Home-screen "Which card?" widget. -->
        <receiver
            android:name=".widget.BestCardWidget"
            android:exported="true"
            android:label="@string/shortcut_which_card_short">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_best_card_info" />
        </receiver>

        <!--
          WorkManager is initialised by TravelBenefitsApp (Configuration.Provider)
          so its workers can be Hilt-injected; the default auto-initialiser
          must be disabled or the two would fight.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Receives the OAuth redirect from the system browser/Custom Tab once
          the user finishes signing in to Google. The scheme here MUST match
          the "reversed client ID" of the Android OAuth client you register
          in Google Cloud Console (see README.md) and the
          `appAuthRedirectScheme` Gradle property used to fill this in.
        -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            android:theme="@style/Theme.TravelBenefits.Redirect"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!--
                  Scheme only, which is what AppAuth and Google's own samples use for a
                  reversed-client-ID redirect. android:path is only meaningful alongside
                  android:host, and there is no host in "com.googleusercontent.apps.x:/oauth2redirect",
                  so specifying it was at best ignored and at worst stopped the redirect matching.
                -->
                <data android:scheme="${appAuthRedirectScheme}" />
            </intent-filter>
        </activity>

    </application>

</manifest>
